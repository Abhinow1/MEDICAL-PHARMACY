# =========================================================
# MediCare Pharmacy - Server Environment Variables
# =========================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Platforms like Render/Railway automatically assign this)
PORT=5001

# MongoDB Connection URI (e.g., from MongoDB Atlas Free M0 cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medicare?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for user and admin authentication (use a long, secure random string)
JWT_SECRET=medicare_secure_production_secret_key_change_me_987654321
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (e.g. https://your-site.vercel.app or https://yourdomain.com)
CLIENT_URL=http://localhost:5173

# Pharmacy WhatsApp Support Number (Indian mobile with country code 91, no plus sign)
WHATSAPP_NUMBER=919876543210

# Optional: Google Gemini API Key for AI Pharmacist (Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: Razorpay Payment Gateway Credentials (Get test keys at https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
