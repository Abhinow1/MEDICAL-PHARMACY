# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# If left empty, the server automatically starts an in-memory MongoDB instance for development & testing
MONGODB_URI=

# Authentication
JWT_SECRET=super_secret_jwt_key_medicare_secure_token_2026_xyz
JWT_EXPIRES_IN=7d

# Store Configuration
STORE_NAME=St Mary's Pharmacy
STORE_PHONE=+919876543210
WHATSAPP_NUMBER=919876543210

# Payment Gateway (Razorpay)
# When left empty, the application runs in simulated TEST payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Chatbot Configuration
# Optional: Provide Google Gemini API Key for advanced natural language responses.
# Fallback rule-based intelligent pharmacy assistant runs automatically if empty.
GEMINI_API_KEY=
